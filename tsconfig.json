{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "baseUrl": ".",
        "moduleResolution": "Bundler",
        "paths": {
            "@root/*": ["./*"],
            "@src/*": ["./src/*"],
            "@components/*": ["./src/components/*"],
            "@layouts/*": ["./src/layouts/*"],
            "@images/*": ["./src/assets/images/*"],
            "@pages/*": ["./src/pages/*"],
            "@scripts/*": ["./src/scripts/*"],
            "@styles/*": ["./src/styles/*"],
            "@templates/*": ["./src/templates/*"],
            "@types/*": ["types/*"],
            "@data/*": ["./src/data/*"],
            "#webgl/*": ["./src/scripts/webgl/*"],
            "#utils/log/logger.ts": ["./src/scripts/shims/utils/log/logger.ts"],
            "#utils/async/wait.ts": ["./src/scripts/shims/utils/async/wait.ts"],
            "#utils/screen/useDPR.ts": ["./src/scripts/shims/utils/screen/useDPR.ts"],
            "#utils/screen/useResize.ts": ["./src/scripts/shims/utils/screen/useResize.ts"],
            "#utils/screen/useScreen.ts": ["./src/scripts/shims/utils/screen/useScreen.ts"],
            "#utils/string.ts": ["./src/scripts/shims/utils/string.ts"],
            "#utils/maths.ts": ["./src/scripts/shims/utils/maths.ts"],
            "#utils/convert.ts": ["./src/scripts/shims/utils/convert.ts"],
            "#stores/device.ts": ["./src/scripts/shims/stores/device.ts"]
        }
    },
    "exclude": ["dist", "node_modules"]
}
