---
import Layout from '@layouts/Layout.astro';
import WheelVega from '@components/WheelVega/WheelVega.astro';

import img0 from '@images/tsl/img-0.jpg';
import img1 from '@images/tsl/img-1.jpg';
import img2 from '@images/tsl/img-2.jpg';
import img3 from '@images/tsl/img-3.jpg';
import img4 from '@images/tsl/img-4.jpg';
import img5 from '@images/tsl/img-5.jpg';
import img6 from '@images/tsl/img-6.jpg';
import img7 from '@images/tsl/img-7.jpg';
import img8 from '@images/tsl/img-8.jpg';
import img9 from '@images/tsl/img-9.jpg';
import img10 from '@images/tsl/img-10.jpg';
import img11 from '@images/tsl/img-11.jpg';
import img12 from '@images/tsl/img-12.jpg';
import img13 from '@images/tsl/img-13.jpg';
import img14 from '@images/tsl/img-14.jpg';
import img15 from '@images/tsl/img-15.jpg';
import img16 from '@images/tsl/img-16.jpg';
import img17 from '@images/tsl/img-17.jpg';
import img18 from '@images/tsl/img-18.jpg';
import img19 from '@images/tsl/img-19.jpg';

const slides = [
    { image: img0, name: 'Épinette' },
    { image: img1, name: 'Ananas' },
    { image: img2, name: 'Chêne' },
    { image: img3, name: 'Fougère' },
    { image: img4, name: 'Lierre' },
    { image: img5, name: 'Bouleau' },
    { image: img6, name: 'Palmier' },
    { image: img7, name: 'Olivier' },
    { image: img8, name: 'Lavande' },
    { image: img9, name: 'Romarin' },
    { image: img10, name: 'Basilic' },
    { image: img11, name: 'Menthe' },
    { image: img12, name: 'Sauge' },
    { image: img13, name: 'Thym' },
    { image: img14, name: 'Camélia' },
    { image: img15, name: 'Jasmin' },
    { image: img16, name: 'Mimosa' },
    { image: img17, name: 'Orchidée' },
    { image: img18, name: 'Pivoine' },
    { image: img19, name: 'Verveine' }
];
---

<Layout title="Wheel">
    <div class="h-[10vh] w-full"></div>
    <WheelVega slides={slides} />
    <div class="h-screen w-full"></div>

    <script>
        import { $CanvasManager } from '@scripts/webgl/core/CanvasManager';
        import { OglWheelVega } from '@scripts/webgl/components/OglWheelVega/OglWheelVega';

        if (!$CanvasManager.has(OglWheelVega.id)) {
            $CanvasManager.register(OglWheelVega.id, OglWheelVega);
        }

        await $CanvasManager.init();
        $CanvasManager.start();

        await import('@scripts/webgl/web-component');
    </script>
</Layout>
